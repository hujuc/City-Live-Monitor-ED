# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# API
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.log

# MinIO (object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Airflow
# Generate Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=changeme
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin

# Superset
SUPERSET_SECRET_KEY=changeme

# Socrata (NYC Open Data)
# Register free token at https://data.cityofnewyork.us/profile/app_tokens
SOCRATA_APP_TOKEN=

# Streaming ingestion
EVENTS_API_URL=https://data.cityofnewyork.us/resource/tvpp-9vvx.json
NOISE311_API_URL=https://data.cityofnewyork.us/resource/erm2-nwe9.json
EVENTS_POLL_SECONDS=1800
NOISE311_POLL_SECONDS=30
EVENTS_API_LIMIT=2000
NOISE311_API_LIMIT=2000
STREAM_REQUEST_TIMEOUT_SECONDS=30
STREAM_CIRCUIT_BREAKER_FAILURES=5
STREAM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=120
EVENTS_CHECKPOINT_FILE=data/checkpoints/events_start_date_time.txt
KAFKA_EVENTS_TOPIC=events.raw
KAFKA_NOISE311_TOPIC=noise311.raw
KAFKA_EVENTS_DLQ_TOPIC=events.dlq
KAFKA_NOISE311_DLQ_TOPIC=noise311.dlq
