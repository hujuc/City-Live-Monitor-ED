# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# API
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.log

# MinIO (object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Airflow
# Generate Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=changeme
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin

# Superset
SUPERSET_SECRET_KEY=changeme

# Socrata (NYC Open Data)
# Register free token at https://data.cityofnewyork.us/profile/app_tokens
SOCRATA_APP_TOKEN=
