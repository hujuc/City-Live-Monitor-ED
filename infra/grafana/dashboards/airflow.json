{
  "title": "NYC Nightlife Pulse - Airflow",
  "uid": "nyc-airflow",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Scheduler Alive",
      "description": "Rate of scheduler heartbeats. Red = scheduler stopped.",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [
        { "expr": "rate(airflow_scheduler_heartbeat[2m]) > 0", "legendFormat": "alive" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0.001, "color": "green" }
            ]
          },
          "noValue": "0"
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "title": "DAGs Loaded",
      "description": "Number of DAGs in the dagbag. Should be 3.",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [
        { "expr": "airflow_dagbag_size", "legendFormat": "DAGs" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 1, "color": "yellow" },
              { "value": 3, "color": "green" }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "title": "Import Errors",
      "description": "DAG files with import errors. Should always be 0.",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [
        { "expr": "airflow_dag_processing_import_errors", "legendFormat": "errors" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "title": "Executor Open Slots",
      "description": "Available task execution slots. Red if 0 - tasks will queue.",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [
        { "expr": "airflow_executor_open_slots", "legendFormat": "open slots" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 1, "color": "yellow" },
              { "value": 4, "color": "green" }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5,
      "title": "Running Tasks",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [
        { "expr": "airflow_executor_running_tasks", "legendFormat": "running" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } }
      },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 13,
      "title": "Time Since batch_pipeline Last Ran",
      "description": "Seconds since the batch pipeline last completed successfully. Sourced from Pushgateway - shows 'Never' until the DAG runs once.",
      "type": "stat",
      "gridPos": { "x": 0, "y": 4, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "time() - airflow_dag_last_success_timestamp_seconds{dag_id=\"city_live_monitor_batch_pipeline\"}",
          "legendFormat": "batch_pipeline"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdhms",
          "noValue": "Never",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 604800, "color": "yellow" },
              { "value": 864000, "color": "red" }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 14,
      "title": "Time Since daily_prediction Last Ran",
      "description": "Seconds since the daily prediction DAG last completed successfully.",
      "type": "stat",
      "gridPos": { "x": 8, "y": 4, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "time() - airflow_dag_last_success_timestamp_seconds{dag_id=\"city_live_monitor_daily_prediction\"}",
          "legendFormat": "daily_prediction"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdhms",
          "noValue": "Never",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 86400, "color": "yellow" },
              { "value": 172800, "color": "red" }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 15,
      "title": "Time Since weekly_retrain Last Ran",
      "description": "Seconds since the weekly retrain DAG last completed successfully.",
      "type": "stat",
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "time() - airflow_dag_last_success_timestamp_seconds{dag_id=\"city_live_monitor_weekly_retrain\"}",
          "legendFormat": "weekly_retrain"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdhms",
          "noValue": "Never",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 604800, "color": "yellow" },
              { "value": 864000, "color": "red" }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 6,
      "title": "DAG File Parser Lag",
      "description": "How long ago each DAG file was last re-parsed by the DAG processor (resets every ~30s - this is NOT last run time). Red above 300s means the DAG processor is stuck.",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 4 },
      "targets": [
        {
          "expr": "airflow_dag_processing_last_run_seconds_ago_batch_pipeline",
          "legendFormat": "batch_pipeline"
        },
        {
          "expr": "airflow_dag_processing_last_run_seconds_ago_daily_prediction",
          "legendFormat": "daily_prediction"
        },
        {
          "expr": "airflow_dag_processing_last_run_seconds_ago_weekly_retrain",
          "legendFormat": "weekly_retrain"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 60, "color": "yellow" },
              { "value": 300, "color": "red" }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 7,
      "title": "Pool Slots",
      "description": "default_pool slot usage - queued vs running vs open.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 4 },
      "targets": [
        { "expr": "airflow_pool_running_slots_default_pool", "legendFormat": "running" },
        { "expr": "airflow_pool_queued_slots_default_pool", "legendFormat": "queued" },
        { "expr": "airflow_pool_open_slots_default_pool", "legendFormat": "open" }
      ]
    },
    {
      "id": 8,
      "title": "Task Execution Rate",
      "description": "Task instances completing per minute - spikes here confirm a DAG is actually running tasks. Flat = no active DAG runs.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(airflow_ti_successes[2m]) * 60",
          "legendFormat": "successes / min"
        },
        {
          "expr": "rate(airflow_ti_failures[2m]) * 60",
          "legendFormat": "failures / min"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "failures / min" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "successes / min" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          }
        ]
      }
    },
    {
      "id": 9,
      "title": "Scheduler Loop Duration (P50 / P90 / P99)",
      "description": "Time the scheduler spends per loop iteration. Spikes mean the scheduler is under pressure.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "airflow_scheduler_scheduler_loop_duration{quantile=\"0.5\"}",
          "legendFormat": "P50"
        },
        {
          "expr": "airflow_scheduler_scheduler_loop_duration{quantile=\"0.9\"}",
          "legendFormat": "P90"
        },
        {
          "expr": "airflow_scheduler_scheduler_loop_duration{quantile=\"0.99\"}",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 10,
      "title": "DAG Parse Time",
      "description": "Total time to parse all DAG files per scan cycle. High values mean expensive import-time code in DAG files.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "airflow_dag_processing_total_parse_time",
          "legendFormat": "parse time"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
