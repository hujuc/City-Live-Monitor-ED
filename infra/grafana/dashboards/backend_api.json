{
  "title": "NYC Nightlife Pulse — Backend API",
  "uid": "nyc-backend-api",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Backend Up",
      "description": "Green = /metrics is reachable; Red = Prometheus cannot scrape the backend.",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "up{job=\"backend\"}",
          "legendFormat": "backend"
        }
      ],
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "value": 0, "color": "red" },
            { "value": 1, "color": "green" }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Request Rate (req/s)",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"backend\"}[1m]))",
          "legendFormat": "req/s"
        }
      ],
      "options": { "colorMode": "value" }
    },
    {
      "id": 3,
      "title": "Error Rate (5xx %)",
      "description": "Percentage of requests returning HTTP 5xx. Red > 5%.",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "100 * sum(rate(http_requests_total{job=\"backend\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"backend\"}[5m]))",
          "legendFormat": "error %"
        }
      ],
      "options": {
        "colorMode": "background",
        "unit": "percent",
        "thresholds": {
          "steps": [
            { "value": 0, "color": "green" },
            { "value": 1, "color": "yellow" },
            { "value": 5, "color": "red" }
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "P95 Latency",
      "description": "95th percentile request duration in seconds.",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"backend\"}[5m])))",
          "legendFormat": "P95"
        }
      ],
      "options": {
        "colorMode": "background",
        "unit": "s",
        "thresholds": {
          "steps": [
            { "value": 0, "color": "green" },
            { "value": 0.5, "color": "yellow" },
            { "value": 2, "color": "red" }
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "Request Rate by Endpoint",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (handler) (rate(http_requests_total{job=\"backend\"}[1m]))",
          "legendFormat": "{{handler}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "HTTP Status Distribution",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total{job=\"backend\"}[1m]))",
          "legendFormat": "HTTP {{status}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Request Latency Percentiles",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"backend\"}[5m])))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"backend\"}[5m])))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"backend\"}[5m])))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "id": 8,
      "title": "Gold Table 503 Errors",
      "description": "Count of 503 responses from Gold table endpoints — these fire when parquet files are missing.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (handler) (rate(http_requests_total{job=\"backend\",status=\"503\"}[5m]))",
          "legendFormat": "503 {{handler}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "ML Model Health",
      "description": "Model ROC-AUC and F1 from last retrain. Pushed by the weekly_retrain DAG via Pushgateway.",
      "type": "stat",
      "gridPos": { "x": 0, "y": 20, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "ml_classifier_roc_auc",
          "legendFormat": "ROC-AUC"
        }
      ],
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "value": 0, "color": "red" },
            { "value": 0.7, "color": "yellow" },
            { "value": 0.85, "color": "green" }
          ]
        }
      }
    },
    {
      "id": 10,
      "title": "ML Last Retrain",
      "description": "Time since last ML model retrain. Red if > 8 days.",
      "type": "stat",
      "gridPos": { "x": 6, "y": 20, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "time() - ml_last_retrain_timestamp_seconds",
          "legendFormat": "seconds since retrain"
        }
      ],
      "options": {
        "colorMode": "background",
        "unit": "s",
        "thresholds": {
          "steps": [
            { "value": 0, "color": "green" },
            { "value": 604800, "color": "yellow" },
            { "value": 691200, "color": "red" }
          ]
        }
      }
    },
    {
      "id": 11,
      "title": "ML Last Prediction",
      "description": "Time since last prediction parquet was written. Red if > 25 hours.",
      "type": "stat",
      "gridPos": { "x": 12, "y": 20, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "time() - ml_last_prediction_timestamp_seconds",
          "legendFormat": "seconds since last prediction"
        }
      ],
      "options": {
        "colorMode": "background",
        "unit": "s",
        "thresholds": {
          "steps": [
            { "value": 0, "color": "green" },
            { "value": 82800, "color": "yellow" },
            { "value": 90000, "color": "red" }
          ]
        }
      }
    }
  ]
}
